APP_NAME=MediLink API
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

# Exact browser origins allowed to call the API; configure a JSON array.
CORS_ORIGINS=["http://localhost:4200"]

# PostgreSQL connection settings (use your local PostgreSQL account)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=first_db
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_db_password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Firebase Admin SDK uses Application Default Credentials.
# Set GOOGLE_APPLICATION_CREDENTIALS in your shell to a local service-account file path.
FIREBASE_PROJECT_ID=

# Local private file storage; keep uploaded clinical files outside public/static folders.
PRIVATE_UPLOAD_DIR=./data/private_uploads

# Async Redis rate limiter and separate Celery broker database.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
REQUEST_LIMIT_PER_MINUTE=120

# Docker Compose mounts this credential file as a secret; never commit the JSON.
# Windows example: C:/secrets/medilink-firebase.json
FIREBASE_CREDENTIALS_FILE=/absolute/path/to/firebase-service-account.json
